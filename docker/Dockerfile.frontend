# FORGE AI web frontend (original Lovable design: TanStack Start + React 19 + Tailwind 4).
# The Lovable Vite config targets Cloudflare by default; NITRO_PRESET=node-server produces a
# self-contained Node server instead, without changing the project configuration.
FROM node:22-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# URL of the FORGE AI platform API as seen from the user's browser.
ARG VITE_API_BASE_URL=http://localhost:8000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    NITRO_PRESET=node-server
RUN npm run build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/.output ./.output
ENV HOST=0.0.0.0 \
    PORT=3000
EXPOSE 3000
CMD ["node", ".output/server/index.mjs"]
