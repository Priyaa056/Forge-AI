  "routes": [
    {
      "path": "/",
      "component_name": "DashboardPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Dashboard"
    },
    {
      "path": "/login",
      "component_name": "LoginPage",
      "exact": true,
      "protected": false,
      "title": "TaskFlow - Login"
    },
    {
      "path": "/register",
      "component_name": "RegisterPage",
      "exact": true,
      "protected": false,
      "title": "TaskFlow - Register"
    },
    {
      "path": "/users",
      "component_name": "UserPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Users"
    },
    {
      "path": "/users/:id",
      "component_name": "UserDetailPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - User Detail"
    },
    {
      "path": "/tasks",
      "component_name": "TaskPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Tasks"
    },
    {
      "path": "/tasks/:id",
      "component_name": "TaskDetailPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Task Detail"
    },
    {
      "path": "/categories",
      "component_name": "CategoryPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Categorys"
    },
    {
      "path": "/categories/:id",
      "component_name": "CategoryDetailPage",
      "exact": true,
      "protected": true,
      "title": "TaskFlow - Category Detail"
    }
  ],
  "layouts": [
    {
      "name": "MainLayout",
      "description": "Standard main application layout",
      "slots": [
        "main"
      ],
      "default_layout": true
    },
    {
      "name": "AuthLayout",
      "description": "Authentication page layout",
      "slots": [
        "main"
      ],
      "default_layout": false
    }
  ],
