{
  "project_name": "TaskFlow",
  "pages": [
    {
      "name": "DashboardPage",
      "route_path": "/",
      "layout": "MainLayout",
      "description": "Main dashboard summary overview for TaskFlow",
      "components_used": [
        "Navbar",
        "Sidebar",
        "StatsCard"
      ],
      "required_auth": true,
      "state_requirements": [
        "currentUser",
        "metrics"
      ]
    },
    {
      "name": "LoginPage",
      "route_path": "/login",
      "layout": "AuthLayout",
      "description": "User authentication login page",
      "components_used": [
        "LoginForm",
        "AuthCard"
      ],
      "required_auth": false,
      "state_requirements": [
        "loginCredentials",
        "authError"
      ]
    },
    {
      "name": "RegisterPage",
      "route_path": "/register",
      "layout": "AuthLayout",
      "description": "User account registration page",
      "components_used": [
        "RegisterForm",
        "AuthCard"
      ],
      "required_auth": false,
      "state_requirements": [
        "registrationData",
        "validationErrors"
      ]
    },
    {
      "name": "UserPage",
      "route_path": "/users",
      "layout": "MainLayout",
      "description": "Management page for User items",
      "components_used": [
        "Navbar",
        "Sidebar",
        "UserTable",
        "UserFilterBar"
      ],
      "required_auth": true,
      "state_requirements": [
        "usersList",
        "filterQuery"
      ]
    },
    {
      "name": "UserDetailPage",
      "route_path": "/users/:id",
      "layout": "MainLayout",
      "description": "Detailed view and editor for User",
      "components_used": [
        "Navbar",
        "Sidebar",
        "UserDetail",
        "UserForm"
      ],
      "required_auth": true,
      "state_requirements": [
        "selectedUser",
        "isEditing"
      ]
    },
    {
      "name": "TaskPage",
      "route_path": "/tasks",
      "layout": "MainLayout",
      "description": "Management page for Task items",
      "components_used": [
        "Navbar",
        "Sidebar",
        "TaskTable",
        "TaskFilterBar"
      ],
      "required_auth": true,
      "state_requirements": [
        "tasksList",
        "filterQuery"
      ]
    },
    {
      "name": "TaskDetailPage",
      "route_path": "/tasks/:id",
      "layout": "MainLayout",
      "description": "Detailed view and editor for Task",
      "components_used": [
        "Navbar",
        "Sidebar",
        "TaskDetail",
        "TaskForm"
      ],
      "required_auth": true,
      "state_requirements": [
        "selectedTask",
        "isEditing"
      ]
    },
    {
      "name": "CategoryPage",
      "route_path": "/categories",
      "layout": "MainLayout",
      "description": "Management page for Category items",
      "components_used": [
        "Navbar",
        "Sidebar",
        "CategoryTable",
        "CategoryFilterBar"
      ],
      "required_auth": true,
      "state_requirements": [
        "categoriesList",
        "filterQuery"
      ]
    },
    {
      "name": "CategoryDetailPage",
      "route_path": "/categories/:id",
      "layout": "MainLayout",
      "description": "Detailed view and editor for Category",
      "components_used": [
        "Navbar",
        "Sidebar",
        "CategoryDetail",
        "CategoryForm"
      ],
      "required_auth": true,
      "state_requirements": [
        "selectedCategory",
        "isEditing"
      ]
    }
  ],
  "components": [
    {
      "name": "Navbar",
      "type": "navbar",
      "description": "Top navigation header",
      "props": [
        {
          "name": "user",
          "type": "UserObject",
          "required": "false"
        },
        {
          "name": "onLogout",
          "type": "function",
          "required": "false"
        }
      ],
      "state_variables": [
        {
          "name": "isProfileDropdownOpen",
          "type": "boolean",
          "default": "false"
        }
      ],
      "event_handlers": [
        "onToggleMenu",
        "onLogoutClick"
      ],
      "child_components": [
        "UserProfileDropdown",
        "ThemeToggle"
      ]
