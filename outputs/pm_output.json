{
  "project_name": "Task Management App",
  "description": "An application designed to help users organize, track, and manage their tasks efficiently, allowing for task creation, progress tracking, and prioritization.",
  "features": [
    "Create new tasks with title, description, due date, and priority",
    "View a list of all tasks",
    "Mark tasks as complete/incomplete",
    "Edit existing task details",
    "Delete tasks",
    "Filter tasks by status (e.g., pending, completed)",
    "Sort tasks by due date or priority"
  ],
  "tech_stack": {
    "frontend": "React",
    "backend": "FastAPI",
    "database": "SQLite"
  },
  "database_entities": [
    {
      "name": "Task",
      "fields": [
        {
          "name": "id",
          "type": "integer"
        },
        {
          "name": "title",
          "type": "string"
        },
        {
          "name": "description",
          "type": "text"
        },
        {
          "name": "due_date",
          "type": "datetime"
        },
        {
          "name": "priority",
          "type": "string"
        },
        {
          "name": "status",
          "type": "string"
        },
        {
          "name": "created_at",
          "type": "datetime"
        },
        {
          "name": "updated_at",
          "type": "datetime"
        }
      ]
    }
  ]
}