{
  "project_name": "TaskFlow",
  "description": "A streamlined task management application that helps users organize, prioritize, and track their daily tasks and projects.",
  "features": [
    "User registration and secure authentication",
    "Create, read, update, and delete (CRUD) tasks",
    "Set task priorities, due dates, and status tracking",
    "Organize tasks by categories and tags",
    "Filter and search tasks by priority, status, or date range"
  ],
  "tech_stack": {
    "frontend": "React",
    "backend": "FastAPI",
    "database": "SQLite"
  },
  "database_entities": [
    {
      "name": "User",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER"
        },
        {
          "name": "username",
          "type": "VARCHAR"
        },
        {
          "name": "email",
          "type": "VARCHAR"
        },
        {
          "name": "hashed_password",
          "type": "VARCHAR"
        },
        {
          "name": "created_at",
          "type": "DATETIME"
        }
      ]
    },
    {
      "name": "Task",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER"
        },
        {
          "name": "user_id",
          "type": "INTEGER"
        },
        {
          "name": "category_id",
          "type": "INTEGER"
        },
        {
          "name": "title",
          "type": "VARCHAR"
        },
        {
          "name": "description",
          "type": "TEXT"
        },
        {
          "name": "status",
          "type": "VARCHAR"
        },
        {
          "name": "priority",
          "type": "VARCHAR"
        },
        {
          "name": "due_date",
          "type": "DATETIME"
        },
        {
          "name": "created_at",
          "type": "DATETIME"
        }
      ]
    },
    {
      "name": "Category",
      "fields": [
        {
          "name": "id",
          "type": "INTEGER"
        },
        {
          "name": "user_id",
          "type": "INTEGER"
        },
        {
          "name": "name",
          "type": "VARCHAR"
        },
        {
          "name": "color_code",
          "type": "VARCHAR"
        }
      ]
    }
  ]
}