# FORGE AI platform configuration. Copy to backend/.env (preferred) or .env and edit.
# Never commit the real file.

# --- LLM (Google Gemini, used by the PM and UI agents) ---------------------------------
# Without a key FORGE AI runs its deterministic, prompt-driven generators and labels every
# artifact/agent with generation_mode = "deterministic".
USE_LLM=false
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- Platform ---------------------------------------------------------------------------
# Where generated projects, artifacts, logs and the shared frontend toolchain are stored.
# FORGE_WORKSPACE=./workspace
# Build each generated frontend with vite during QA (requires Node.js 18+ on PATH).
FORGE_QA_FRONTEND_BUILD=true
# Allow the dashboard's "simulate failure" test mode.
FORGE_ALLOW_FAULT_INJECTION=true
FORGE_MAX_CONCURRENT_RUNS=2
