# Environment variables template for FORGE AI

# LLM Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
USE_LLM=false

# Deployment Environment
ENVIRONMENT=development
LIVE_URL=http://localhost:8000

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
DB_PORT=5432

# Database Credentials
POSTGRES_USER=forge_user
POSTGRES_PASSWORD=forge_password_change_me
POSTGRES_DB=forge_db
DATABASE_URL=postgresql://forge_user:forge_password_change_me@localhost:5432/forge_db

# Cloud Deployment Credentials (Optional)
DEPLOY_TARGET=local
RENDER_API_KEY=
RAILWAY_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
