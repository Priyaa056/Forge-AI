# FORGE AI platform configuration. Copy to backend/.env (preferred) or .env and edit.
# Never commit the real file.

# --- LLM (used by the PM and UI agents) -------------------------------------------------
# Without a key FORGE AI runs its deterministic, prompt-driven generators and labels every
# artifact/agent with generation_mode = "deterministic".
USE_LLM=false
# Provider: gemini (default), groq, or openai_compatible (OpenRouter, a local server, ...)
LLM_PROVIDER=gemini
# Google Gemini (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Groq (free tier, https://console.groq.com/keys); GROQ_MODEL is optional
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible chat API
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=
# Optional cap on the length of each LLM reply (tokens)
# LLM_MAX_TOKENS=

# --- Platform ---------------------------------------------------------------------------
# Where generated projects, artifacts, logs and the shared frontend toolchain are stored.
# FORGE_WORKSPACE=./workspace
# Build each generated frontend with vite during QA (requires Node.js 18+ on PATH).
FORGE_QA_FRONTEND_BUILD=true
# Allow the dashboard's "simulate failure" test mode.
FORGE_ALLOW_FAULT_INJECTION=true
FORGE_MAX_CONCURRENT_RUNS=2
